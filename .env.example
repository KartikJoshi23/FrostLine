# Copy this file to .env and fill it in. Never commit .env.

# TronGrid key: register for free at https://www.trongrid.io/ . Each member uses their own key.
TRONGRID_API_KEY=

# Google Cloud project ID with the BigQuery sandbox (master laptop only).
GOOGLE_CLOUD_PROJECT=

# Hard cap per BigQuery query, in bytes (plan 2.3). The main pull uses its own approved cap.
BIGQUERY_MAX_BYTES_BILLED=25000000000
